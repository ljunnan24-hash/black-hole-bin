{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Black Hole Bin",
  "version": "0.2.0",
  "identifier": "com.junnan.blackholebin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Black Hole Bin",
        "width": 340,
        "height": 340,
        "minWidth": 280,
        "minHeight": 280,
        "maxWidth": 420,
        "maxHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Junnan",
    "copyright": "Copyright © 2026 Junnan",
    "category": "Utility",
    "shortDescription": "A black hole for the Windows Recycle Bin",
    "longDescription": "Drop files or folders onto a gravitationally lensed black hole to move them safely into the Windows Recycle Bin.",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
